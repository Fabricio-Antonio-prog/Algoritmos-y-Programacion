Algoritmo circuito2
	Definir p, q Como Logico
	
	p <- Verdadero
	q <- Verdadero
	Escribir p,"-",q,"-",p o q,"-", no (p o q),"-", (no (p o q)) y (p o q)
	
	p <- Verdadero
	q <- Falso
	Escribir p,"-",q,"-",p o q,"-", no (p o q),"-", (no (p o q)) y (p o q)
	
	p <- Falso
	q <- Verdadero
	Escribir p,"-",q,"-",p o q,"-", no (p o q),"-", (no (p o q)) y (p o q)
	
	p <- Falso
	q <- Falso
	Escribir p,"-",q,"-",p o q,"-", no (p o q),"-", (no (p o q)) y (p o q)
	
FinAlgoritmo
