// Suma de los números pares comprendidos entre 2 y 100.
Algoritmo ejercicio4
	Definir suma, num Como Entero
	suma <- 2
	num <- 4
	Mientras num<=100 Hacer
		suma <- suma+num
		num <- num+2
	FinMientras
	Escribir 'La suma de los números pares comprendidos entre 2 y 100 es: ', suma
FinAlgoritmo
