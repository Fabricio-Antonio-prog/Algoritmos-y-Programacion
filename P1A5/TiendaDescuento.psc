//Una tienda ofrece un descuento del 15 % sobre el total de la compra 
//y un cliente desea saber cua?nto debera? pagar finalmente por esta.
Algoritmo TiendaDescuento
	Definir comp, desc Como Real
	Escribir "Ingresa el valor de tu compra toal"
	Leer comp
	desc <- comp*0.85
	Escribir "Tu compra con el 15% de descuento queda en: ", desc
FinAlgoritmo
