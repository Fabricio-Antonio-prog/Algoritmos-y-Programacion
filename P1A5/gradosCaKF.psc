//Realizar un algoritmo en pseudocodigo para convertir grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo gradosCaKF
	Definir gradC, gradK, gradF Como Real
	Escribir "Escribe el número de grados Celsius que quieras convertir"
	Leer gradC
	gradk <- gradC+273.15
	gradF <- (gradc*1.8)+32
	Escribir "La conversión a grados Kelvin es: ", gradk,"°"
	Escribir "La conversión a grados Farenheit es: ", gradF,"°"
FinAlgoritmo
